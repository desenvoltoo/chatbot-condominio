# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações da Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_global_evolution_aqui
EVOLUTION_INSTANCE_NAME=condominio_bot

# Configuração do ERP Condominial
# 'mock' para desenvolvimento/testes, 'superlogica' ou 'custom' para produção
ERP_PROVIDER=mock
ERP_BASE_URL=https://api.erpcondominio.com.br/v1
ERP_APP_TOKEN=seu_app_token_erp
ERP_ACCESS_TOKEN=seu_access_token_erp

# Dados da Administradora
NOME_ADMINISTRADORA=Administradora Modelo
TELEFONE_SUPORTE=5511999999999
HORARIO_ATENDIMENTO="Segunda a Sexta, das 08h às 18h"

# Plantão e Alertas Prioritários de Transbordo (WhatsApp JID do Consultor ou Grupo de Plantão)
# Se não informado, utilizará automaticamente o TELEFONE_SUPORTE
WHATSAPP_PLANTAO_JID=5511999999999@s.whatsapp.net

# Régua de Cobrança Preventiva Automática (D-3, D-0, D+3 com Pix Copia e Cola)
REGUA_AUTO_ENABLED=true
REGUA_HORA_DISPARO=9
